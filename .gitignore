# ============================================
# 人生重开模拟器 — Git 忽略规则
# ============================================

# 依赖
node_modules/

# 构建产物
dist/
docs/
out/
release/

# 平台构建产物（阶段五，由构建脚本生成，勿提交）
platforms/electron/dist-web/
platforms/electron/release/
platforms/web/public/
platforms/web/release/
platforms/web/bundle/
platforms/mobile/www/
# APK 内置 Node 侧（main.js + 打包好的 proxy.js）：build-node-project.js 的产物
platforms/mobile/nodejs-build/
# 官方 nodejs-mobile 运行时（~54 MB 的 zip / 解压后的 include+bin）：CI 现场下载，勿入库
platforms/mobile/.libnode/
# 测试临时产物（esbuild 打包产物等）
platforms/mobile/.tmp/

# Data Mod（原版数据转换产物）已入库：mods/lifeRestart-data/
# 内容与 packages/frontend/public/data/ 一致（同一转换产物），保证干净克隆后
# CLI（smoke / ai-game / consistency）与测试开箱即用。勿手工编辑。

# 日志
*.log

# 环境变量（含 API Key）
.env
.env.local

# IDE
.vscode/
.idea/

# 测试覆盖率报告
coverage/

# pnpm store（避免提交缓存）
.pnpm-store/

# Electron 打包配置
electron-builder.yml

# Capacitor 原生壳（自动生成，不提交）
android/
ios/

# 操作系统文件
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# 生成的 Mod 静态资源（scripts/sync-mods.mjs 同步，不入库）
packages/frontend/public/mods/

